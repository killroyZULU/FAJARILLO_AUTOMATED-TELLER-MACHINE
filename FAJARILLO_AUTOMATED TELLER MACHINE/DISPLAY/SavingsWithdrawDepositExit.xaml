<UserControl x:Class="FAJARILLO_AUTOMATED_TELLER_MACHINE.DISPLAY.SavingsWithdrawDepositExit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FAJARILLO_AUTOMATED_TELLER_MACHINE.DISPLAY"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="500">
    <Grid x:Name="MainGrid" Visibility="Visible">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftSideDisplayButtons"  Width="100"></ColumnDefinition>
            <ColumnDefinition x:Name="MainScreen"></ColumnDefinition>
            <ColumnDefinition x:Name="RightSideDisplayButtons" Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Canvas x:Name="LeftSideButtons" Grid.Column="0">

            <Button x:Name="Button1" Content=" > " Panel.ZIndex="1" Height="65" Width="72" Canvas.Left="14" Canvas.Top="36" HorizontalAlignment="Center" VerticalAlignment="Top" />
            <Button x:Name="Button2" Content=" > " Panel.ZIndex="1" Height="65" Width="72" Canvas.Left="14" Canvas.Top="249" HorizontalAlignment="Center" VerticalAlignment="Top" />
            <Button x:Name="Button3" Content=" > " Panel.ZIndex="1" Height="65" Width="72" Canvas.Left="14" Canvas.Top="138" HorizontalAlignment="Center" VerticalAlignment="Top" />

        </Canvas>

        <Canvas x:Name="RightSideButtons" Grid.Column="2">

            <Button x:Name="Button4" Content=" &lt; " Panel.ZIndex="1" Height="65" Width="72" Canvas.Left="14" Canvas.Top="36" HorizontalAlignment="Center" VerticalAlignment="Top" Click="DepositButton_Click"/>
            <Button x:Name="Button5" Content=" &lt; " Panel.ZIndex="1" Height="65" Width="72" Canvas.Left="14" Canvas.Top="249" HorizontalAlignment="Center" VerticalAlignment="Top" Click="ExitButton_Click"/>
            <Button x:Name="Button6" Content=" &lt; " Panel.ZIndex="1" Height="65" Width="72" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="14" Canvas.Top="138" Click="WithdrawButton_Click" />
        </Canvas>

        <Canvas x:Name="CenterDisplay" Grid.Column="1">
            <Grid Width="300" Height="350" Grid.Column="1" Background="Black">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label Content="Deposit" Background="LightSlateGray" Foreground="White"
                       HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                       Grid.Row="0" Grid.Column="0"
                       Margin="165,42,20,27" 
                       BorderBrush="DarkSlateGray" BorderThickness="2"/>

                <Label Content="Withdraw" Background="LightSlateGray" Foreground="White"
                       HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                       Grid.Row="1" Grid.Column="0"
                       Margin="165,29,20,39" 
                       BorderBrush="DarkSlateGray" BorderThickness="2"/>

                <Label Content="Exit" Background="LightSlateGray" Foreground="White"
                       HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                       Grid.Row="2" Grid.Column="0"
                       Margin="165,23,20,45" 
                       BorderBrush="DarkSlateGray" BorderThickness="2"/>



                <TextBlock x:Name="CurrentSavings" Text="CURRENT SAVINGS:" Foreground="White" HorizontalAlignment="Left" Margin="10,16,0,11" Grid.Row="1" Width="131" FontSize="15"/>
                <TextBlock x:Name="Balance" Text="" Foreground="White" HorizontalAlignment="Left" Margin="22,64,0,86" Grid.Row="1" Grid.RowSpan="2"/>




            </Grid>





        </Canvas>

        <Rectangle Width="500" Height="350" Fill="LightGray" Panel.ZIndex="-1" Grid.ColumnSpan="3"/>
       
    </Grid>
        
</UserControl>

<UserControl x:Class="FAJARILLO_AUTOMATED_TELLER_MACHINE.DISPLAY.WithdrawScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FAJARILLO_AUTOMATED_TELLER_MACHINE.DISPLAY"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="300">
    <Grid Background="LightGray">
        <Grid Width="300" Height="350" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ENTER AMOUNT TO WITHDRAW:" Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,20,0,10" Grid.Row="0"/>

            <Label x:Name="DepositAmount" Content="{Binding AmountWithdraw}" Background="LightSlateGray" Foreground="White" 
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                FontSize="24" Height="40" Width="260" Grid.Row="1" Margin="20,0,20,20" BorderBrush="DarkSlateGray" BorderThickness="2"/>


        </Grid>
    </Grid>
</UserControl>

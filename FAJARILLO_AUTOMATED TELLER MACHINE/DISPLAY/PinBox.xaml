<UserControl x:Class="FAJARILLO_AUTOMATED_TELLER_MACHINE.DISPLAY.PinBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FAJARILLO_AUTOMATED_TELLER_MACHINE.DISPLAY"
             mc:Ignorable="d" 
             Height="75" Width="250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

   <!-- Pin Entry Box Text -->
        <Label x:Name="PinEntryBox"  Content="{Binding PinBoxText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
       FontSize="15"
       Background="LightSlateGray"
       Foreground="White"
       Width="250" Height="75"
       HorizontalContentAlignment="Center"
       VerticalContentAlignment="Center"
       HorizontalAlignment="Center"
       VerticalAlignment="Center"
       BorderBrush="DarkSlateGray" BorderThickness="5"/>
        
    </Grid>
</UserControl>
